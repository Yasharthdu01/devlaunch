# --- Core ---
PORT=5000
DATABASE_URL=postgres://user:password@host:5432/devlaunch
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed frontend origins (no trailing slash).
# If unset, defaults to localhost:3000 and the known Vercel domains.
CORS_ORIGINS=http://localhost:3000,https://devlaunch-sand-gamma.vercel.app

# --- LLM (any OpenAI-compatible API) ---
# Production, e.g. Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=openai/gpt-oss-20b  LLM_REASONING_EFFORT=low
#   (model access varies per key: the server logs the models your key can use at startup)
# Production, e.g. OpenAI: LLM_BASE_URL=https://api.openai.com/v1       LLM_MODEL=gpt-4o-mini
# Local Ollama:            LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3.2  (no key needed)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=
LLM_TIMEOUT_MS=30000

# For reasoning models (gpt-oss, qwen3, ...): low | medium | high. Leave empty for regular chat models.
LLM_REASONING_EFFORT=
# Extra output tokens allowed for reasoning when LLM_REASONING_EFFORT is set
LLM_REASONING_TOKENS=1500

# Max AI requests per IP per minute
AI_RATE_LIMIT_PER_MIN=10

# --- Email (optional) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
